APP_NAME=DevBattle AI
APP_ENV=development
DEBUG=true

DATABASE_URL=YOUR_DATABASE_URL

SUPABASE_URL=YOUR_SUPABASE_URL

SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

PLAYWRIGHT_HEADLESS=true

# Shared secret required by all /internal/* routes via the X-Internal-Api-Key header.
# REQUIRED in any environment reachable from the public internet -- leaving it unset disables
# auth entirely (only acceptable for local development).
INTERNAL_API_KEY=YOUR_RANDOM_LONG_SECRET

# Comma-separated list of allowed browser origins for CORS, e.g. https://app.devbattles.com
# Use "*" only for local development. "*" cannot be combined with credentialed requests.
CORS_ALLOWED_ORIGINS=*

# Enables the model router's "simulate 429/404/503/timeout/network" fault-injection test hooks.
# Leave this OFF (false) in any environment that accepts real user input -- it is only meant to
# be turned on by app/tests/test_router_simulation.py against a disposable local server.
ENABLE_ROUTER_FAULT_SIMULATION=false
